{
  "name": "booth-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm run chat\" \"vite\"",
    "chat": "node --env-file=../.env server/chat.mjs",
    "dev:web": "vite",
    "build": "node ./node_modules/typescript/bin/tsc --noEmit && node ./node_modules/vite/bin/vite.js build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.90.2",
    "concurrently": "^9.2.1",
    "ioredis": "^5.11.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "viem": "^2.37.9",
    "wagmi": "^2.17.5",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.3",
    "typescript": "~5.9.2",
    "vite": "^7.1.7"
  }
}
